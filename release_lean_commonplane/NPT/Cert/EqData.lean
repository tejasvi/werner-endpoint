/-- Backward tables: the embedding of `V3 q` is `V_{p}`. -/
def embTab : List (List ℕ) := [nat_list% "0 1 2 3 4 5", nat_list% "0 2 6 8 12 14", nat_list% "0 5 6 11 19 21", nat_list% "0 1 14 15 20 21", nat_list% "0 14 21 15 20 1"]

def sget (c j : ℕ) : ℕ := (slotTab.getD c []).getD j 0
def tget (c : ℕ) (p : Fin 24) (j : ℕ) : ℕ := ((trTab.getD c []).getD p.val []).getD j 0

def csl (c : ℕ) : Fin 4 := Fin.ofNat 4 (sget c 0)
def cord (c : ℕ) (u : Fin 3) : Fin 4 := Fin.ofNat 4 (sget c (1 + u.val))
def cinv (c : ℕ) (t : Fin 4) : Fin 3 := Fin.ofNat 3 (sget c (4 + t.val))

def SOok (c : ℕ) : Prop :=
  (∀ u, cord c u ≠ csl c) ∧ (∀ u, cinv c (cord c u) = u) ∧ (∀ t, t ≠ csl c → cord c (cinv c t) = t)

instance (c : ℕ) : Decidable (SOok c) := by unfold SOok; infer_instance

theorem slotTab_ok : ∀ c : Fin 5, SOok c.val := by decide +kernel

/-- The slot data of combination `c`. -/
def soOf {c : ℕ} (h : SOok c) : SlotOrd := ⟨csl c, cord c, cinv c, h.1, h.2.1, h.2.2⟩

section Fwd

variable (c : ℕ) (p : Fin 24)

def te : ℕ := tget c p 0
def tq : Fin 6 := Fin.ofNat 6 (tget c p 1)

def tσ (v : Fin 4) : Fin 3 ⊕ Fin (te c p) :=
  let x := tget c p (2 + v.val)
  if h : x < 3 then Sum.inl ⟨x, h⟩ else
    if h' : x - 3 < te c p then Sum.inr ⟨x - 3, h'⟩ else Sum.inl 0

def tτ : Fin 3 ⊕ Fin (te c p) → Fin 4 :=
  Sum.elim (fun t => Fin.ofNat 4 (tget c p (6 + t.val))) (fun j => Fin.ofNat 4 (tget c p (9 + j.val)))

def tpar (v : Fin 4) : Fin 4 := Fin.ofNat 4 (tget c p (10 + v.val))
def tdep (v : Fin 4) : ℕ := tget c p (14 + v.val)

/-- Conditions of the forward certificate (`α = aSel 0 p`, `β = bSel 0 p`). -/
def TCertOK : Prop :=
  (∀ _ : Fin 1, tσ c p (aSel 0 p (csl c)) = tσ c p (bSel 0 p (csl c))) ∧
  (∀ t : Fin 3, tσ c p (tτ c p (Sum.inl t)) = Sum.inl t) ∧
  (∀ j : Fin (te c p), tσ c p (tτ c p (Sum.inr j)) = Sum.inr j) ∧
  (∀ u : Fin 3, tσ c p (aSel 0 p (cord c u)) = Sum.inl (p3inv (tq c p) u)) ∧
  (∀ u : Fin 3, tσ c p (bSel 0 p (cord c u)) = Sum.inl u) ∧
  (∀ v : Fin 4, v = tτ c p (tσ c p v) ∨
    (tdep c p (tpar c p v) < tdep c p v ∧ tσ c p (tpar c p v) = tσ c p v ∧
      ∃ _ : Fin 1, (v = aSel 0 p (csl c) ∧ tpar c p v = bSel 0 p (csl c)) ∨
        (v = bSel 0 p (csl c) ∧ tpar c p v = aSel 0 p (csl c))))

instance : Decidable (TCertOK c p) := by unfold TCertOK; infer_instance

def tcert (h : TCertOK c p) :
    GCert (fun _ : Fin 1 => (aSel 0 p (csl c), bSel 0 p (csl c))) (aSel 0 p ∘ cord c) (bSel 0 p ∘ cord c)
      (p3inv (tq c p)) id (te c p) where
  σ := tσ c p
  τ := tτ c p
  par := tpar c p
  dep := tdep c p
  hA := h.1
  hB := by
    rintro (t | j)
    · exact h.2.1 t
    · exact h.2.2.1 j
  hC1 := h.2.2.2.1
  hC2 := h.2.2.2.2.1
  hD := h.2.2.2.2.2

end Fwd

theorem trTab_ok : ∀ c : Fin 5, ∀ p : Fin 24, TCertOK c.val p := by decide +kernel

/-- Backward image index. -/
def bq (c : ℕ) (q : Fin 6) : Fin 24 := Fin.ofNat 24 ((embTab.getD c []).getD q.val 0)

theorem embTab_ok : ∀ c : Fin 5, ∀ q : Fin 6, ∀ t : Fin 4,
    (if t = csl c then csl c else cord c (p3inv q (cinv c t))) = pinvf (bq c q) t := by decide +kernel

variable {n : ℕ}

/-- **Forward closed form**: `Tr_{sl,ord}(V_p) = n^e · V3_q`. -/
theorem delK_VG {c : ℕ} (hc : SOok c) (p : Fin 24) (ht : TCertOK c p) :
    applyK (delK (n := n) (csl c) (cord c)) (VG ℂ n 0 p) = ((n : ℂ) ^ te c p) • V3 n (tq c p) := by
  unfold VG V3
  rw [delK_SelOp]
  exact (tcert c p ht).csum_eq

/-- **Backward closed form**: the adjoint of the partial trace maps `V3_q` to `V_{p'}`. -/
theorem adj_delK_V3 {c : ℕ} (hc : SOok c) (q : Fin 6)
    (hb : ∀ t : Fin 4, (if t = csl c then csl c else cord c (p3inv q (cinv c t))) = pinvf (bq c q) t) :
    applyA (delK (n := n) (csl c) (cord c)) (V3 n q) = VG ℂ n 0 (bq c q) := by
  unfold V3 VG
  have := (soOf hc).adj_delK_SelOp (n := n) (p3inv q) id
  simp only [soOf] at this
  rw [this]
  congr 1
  · funext t
    have e1 : aSel 0 (bq c q) t = pinvf (bq c q) t := by simp [aSel, inS]
    rw [e1, ← hb t]
    rfl
  · funext t
    simp only [SlotOrd.emb, id]
    by_cases h : t = csl c
    · simp [h, bSel, inS]
    · simp [h, hc.2.2 t h, bSel, inS]

end NPT.Cert
