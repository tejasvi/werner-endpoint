import NPT.Cert.EqLocal
import NPT.Cert.Lit

open Matrix BigOperators Finset NPT.Brauer

namespace NPT.Cert

/-- Permutations of three replicas (itertools order). -/
def permL3 : List (List ℕ) := [[0,1,2],[0,2,1],[1,0,2],[1,2,0],[2,0,1],[2,1,0]]

/-- Inverse of the `q`-th permutation of three replicas. -/
def p3inv (q : Fin 6) (u : Fin 3) : Fin 3 := Fin.ofNat 3 ((permL3.getD q.val []).idxOf u.val)

/-- Three-replica permutation operator `V3_q` (ep3core `perm_op(n, q, 3)`). -/
def V3 (n : ℕ) (q : Fin 6) : Matrix (Dig n 3) (Dig n 3) ℂ := SelOp ℂ n (p3inv q) id

/-- Slot data `[sl, ord_0, ord_1, ord_2, ordInv_0..ordInv_3]` of the five traced-slot combinations. -/
