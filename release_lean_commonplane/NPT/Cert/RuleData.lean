/-- Number of verified rules. -/
def nRules : ℕ := 13

def rget (i j t : ℕ) : ℕ := ((ruleTab.getD i []).getD j []).getD t 0
def rkp (i : ℕ) (s : Fin 4) : Fin (4 + 4) := Fin.ofNat (4 + 4) (rget i 0 s.val)
def rlp (i : ℕ) (s : Fin 4) : Fin (4 + 4) := Fin.ofNat (4 + 4) (rget i 1 s.val)
def rinv (i : ℕ) (c : Fin (4 + 4)) : Fin (4 + 4) := Fin.ofNat (4 + 4) (rget i 2 c.val)
def rcut (i : ℕ) : ℕ := rget i 3 0
def rfq (i : ℕ) (p : Fin 24) : Fin 24 := Fin.ofNat 24 (rget i 4 (2 * p.val))
def rfπ (i : ℕ) (p : Fin 24) : Fin 24 := Fin.ofNat 24 (rget i 4 (2 * p.val + 1))
def rbq (i : ℕ) (q : Fin 24) : Fin 24 := Fin.ofNat 24 (rget i 5 (2 * q.val))
def rbπ (i : ℕ) (q : Fin 24) : Fin 24 := Fin.ofNat 24 (rget i 5 (2 * q.val + 1))

/-- Validity of rule `i`: `pos` is a bijection with inverse `rinv`, and the forward/backward tables are
correct reparametrisations. -/
def RuleOK (i : ℕ) : Prop :=
  (∀ c, Fin.append (rkp i) (rlp i) (rinv i c) = c) ∧ (∀ u, rinv i (Fin.append (rkp i) (rlp i) u) = u) ∧
  (∀ p : Fin 24, ∀ s : Fin 4,
     Fin.append (aSel 0 p) (bSel 0 p) (rinv i (Fin.castAdd 4 s)) = pf (rfπ i p) (aSel (rcut i) (rfq i p) s) ∧
     Fin.append (aSel 0 p) (bSel 0 p) (rinv i (Fin.natAdd 4 s)) = pf (rfπ i p) (bSel (rcut i) (rfq i p) s)) ∧
  (∀ q : Fin 24, ∀ s : Fin 4,
     Fin.append (aSel (rcut i) q) (bSel (rcut i) q) (rkp i s) = pf (rbπ i q) (aSel 0 (rbq i q) s) ∧
     Fin.append (aSel (rcut i) q) (bSel (rcut i) q) (rlp i s) = pf (rbπ i q) (bSel 0 (rbq i q) s))

instance (i : ℕ) : Decidable (RuleOK i) := by unfold RuleOK; infer_instance

theorem ruleTab_ok : ∀ i : Fin 13, RuleOK i.val := by decide +kernel

/-- Position data of a valid rule. -/
def RuleOK.pos {i : ℕ} (h : RuleOK i) : RulePos := ⟨rkp i, rlp i, rinv i, h.1, h.2.1⟩

variable {n : ℕ}

lemma RuleOK.ruleL_V {i : ℕ} (h : RuleOK i) (p : Fin 24) :
    ruleL (rkp i) (rlp i) (VG ℂ n 0 p) = VG ℂ n (rcut i) (rfq i p) := by
  unfold VG
  rw [show ruleL (rkp i) (rlp i) = ruleL h.pos.kp h.pos.lp from rfl, h.pos.ruleL_SelOp,
    ← SelOp_reindex (permE (rfπ i p)) (aSel (rcut i) (rfq i p)) (bSel (rcut i) (rfq i p))]
  congr 1
  · funext s; exact (h.2.2.1 p s).1
  · funext s; exact (h.2.2.1 p s).2

lemma RuleOK.ruleL_inv_V {i : ℕ} (h : RuleOK i) (q : Fin 24) :
    ruleL h.pos.ikp h.pos.ilp (VG ℂ n (rcut i) q) = VG ℂ n 0 (rbq i q) := by
  unfold VG
  rw [show ruleL h.pos.ikp h.pos.ilp = ruleL h.pos.symm.kp h.pos.symm.lp from rfl,
    h.pos.symm.ruleL_SelOp, h.pos.symm_ikp, h.pos.symm_ilp,
    ← SelOp_reindex (permE (rbπ i q)) (aSel 0 (rbq i q)) (bSel 0 (rbq i q))]
  congr 1
  · funext s; exact (h.2.2.2 q s).1
  · funext s; exact (h.2.2.2 q s).2

section Global

variable {L : Type*} [Fintype L] [DecidableEq L] {nf : L → ℕ}

lemma RuleOK.ruleG_VW {i : ℕ} (h : RuleOK i) (w : L → Fin 24) :
    ruleG (rkp i) (rlp i) (VW nf 0 w) = VW nf (rcut i) (fun l => rfq i (w l)) := by
  unfold VW
  rw [ruleG_kron]
  congr 1
  funext l
  exact h.ruleL_V (w l)

lemma RuleOK.ruleG_inv_VW {i : ℕ} (h : RuleOK i) (w : L → Fin 24) :
    ruleG h.pos.ikp h.pos.ilp (VW nf (rcut i) w) = VW nf 0 (fun l => rbq i (w l)) := by
  unfold VW
  rw [ruleG_kron]
  congr 1
  funext l
  exact h.ruleL_inv_V (w l)

lemma RuleOK.ruleG_mem {i : ℕ} (h : RuleOK i) {Y : Matrix (GI nf) (GI nf) ℂ}
    (hY : Y ∈ spanS (nf := nf) 0) : ruleG (rkp i) (rlp i) Y ∈ spanS (nf := nf) (rcut i) := by
  induction hY using Submodule.span_induction with
  | mem a ha => obtain ⟨w, rfl⟩ := ha; rw [h.ruleG_VW]; exact VW_mem _ _
  | zero => exact Submodule.zero_mem _
  | add x z _ _ h1 h2 => exact Submodule.add_mem _ h1 h2
  | smul c x _ h' => exact Submodule.smul_mem _ c h'

lemma RuleOK.ruleG_inv_mem {i : ℕ} (h : RuleOK i) {N : Matrix (GI nf) (GI nf) ℂ}
    (hN : N ∈ spanS (nf := nf) (rcut i)) : ruleG h.pos.ikp h.pos.ilp N ∈ spanS (nf := nf) 0 := by
  induction hN using Submodule.span_induction with
  | mem a ha => obtain ⟨w, rfl⟩ := ha; rw [h.ruleG_inv_VW]; exact VW_mem _ _
  | zero => exact Submodule.zero_mem _
  | add x z _ _ h1 h2 => exact Submodule.add_mem _ h1 h2
  | smul c x _ h' => exact Submodule.smul_mem _ c h'

end Global

end NPT.Cert
